# Server only: Cloudflare account with Email Sending enabled.
CLOUDFLARE_ACCOUNT_ID=
# Account-scoped API token with Email Sending: Edit permission.
CLOUDFLARE_EMAIL_API_TOKEN=
# Bare sender address on your onboarded domain, e.g. website@cartra.ai.
CLOUDFLARE_EMAIL_FROM=
# Managed Turnstile widget for cartra.ai and www.cartra.ai.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEuqg9DEsiTyBBBB
TURNSTILE_SECRET_KEY=
# Exact frontend hostnames for this deployment; never add localhost in production.
TURNSTILE_HOSTNAMES=cartra.ai,www.cartra.ai
